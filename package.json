{
  "name": "dictationsheetgen",
  "version": "2.5.2",
  "description": "面向中小学英语教师的离线默写纸生成器，支持多题型混排、四线三格、分页与教师答案版。",
  "main": "tests/test_acceptance.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-multifile-dist.mjs",
    "deploy": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1",
    "preview": "vite preview",
    "test": "node tests/test_acceptance.js",
    "test:mobile": "node tests/test_mobile_notice.js",
    "test:p2": "node tests/test_phase2.js",
    "test:p3": "node tests/test_phase3.js",
    "test:alpha": "node tests/test_alphabet.js",
    "test:arch": "node tests/test_architecture_fix.js",
    "test:cloze": "node tests/test_cloze_features.js",
    "test:group": "node tests/test_word_grouping.js",
    "test:i18n": "node tests/test_popconfirm_i18n.js",
    "test:startup": "node tests/test_empty_startup.js",
    "test:excel": "node tests/test_excel_import.js",
    "test:delgroup": "node tests/test_delete_group.js",
    "test:refactor": "node tests/test_v230_refactor.js",
    "test:v240": "node tests/test_question_types_v240.js",
    "test:v240-browser": "node tests/test_question_types_browser.js",
    "test:v241": "node tests/test_v241_features.js",
    "test:ui-audit": "node tests/test_naive_ui_audit.js",
    "test:fonts": "node tests/test_handwriting_fonts.js",
    "test:fonts-browser": "node tests/test_handwriting_fonts_browser.js",
    "test:footer": "node tests/test_app_footer.js",
    "test:align": "node tests/test_alphabet_alignment.js",
    "test:three-col": "node tests/test_three_column_layout.js",
    "test:question-list": "node tests/test_question_list_refactor.js",
    "test:bugfix": "node tests/test_cloze_alphabet_bugfix.js",
    "test:all": "npm run build && node scripts/run-tests.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierWang3P/DictationSheetGen.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/XavierWang3P/DictationSheetGen/issues"
  },
  "homepage": "https://github.com/XavierWang3P/DictationSheetGen#readme",
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "naive-ui": "^2.45.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
