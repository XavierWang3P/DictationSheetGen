{
  "name": "dictationsheetgen",
  "version": "2.2.8",
  "description": "中小学英语默写纸生成器。采用 Vue 3 + Naive UI 现代架构，支持离线单文件运行、四线三格排版、句子挖空、三年级字母专项默写、Excel/CSV/剪贴板表格智能导入与本地离线词库（支持按年级/单元分组管理、完全中文化与首屏干净空白输入体验）。",
  "main": "test_acceptance.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test_acceptance.js",
    "test:p2": "node test_phase2.js",
    "test:p3": "node test_phase3.js",
    "test:alpha": "node test_alphabet.js",
    "test:arch": "node test_architecture_fix.js",
    "test:cloze": "node test_cloze_features.js",
    "test:group": "node test_word_grouping.js",
    "test:i18n": "node test_popconfirm_i18n.js",
    "test:startup": "node test_empty_startup.js",
    "test:excel": "node test_excel_import.js",
    "test:all": "node test_acceptance.js && node test_phase2.js && node test_phase3.js && node test_alphabet.js && node test_architecture_fix.js && node test_cloze_features.js && node test_word_grouping.js && node test_popconfirm_i18n.js && node test_empty_startup.js && node test_excel_import.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XavierWang3P/DictationSheetGen.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/XavierWang3P/DictationSheetGen/issues"
  },
  "homepage": "https://github.com/XavierWang3P/DictationSheetGen#readme",
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "naive-ui": "^2.45.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vue": "^3.5.44",
    "xlsx": "^0.18.5"
  }
}
